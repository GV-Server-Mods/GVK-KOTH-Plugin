<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure KOTH rules and config: no Torch or game references, so GVK_KOTH.Tests can run them with dotnet test. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>GVK_KOTH.Core</AssemblyName>
    <RootNamespace>GVK.Koth.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
